<Window x:Class="AutoVistaTestBench.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:AutoVistaTestBench.Views"
        xmlns:viewmodels="clr-namespace:AutoVistaTestBench.ViewModels"
        mc:Ignorable="d"
        Title="AutoVista Test Bench"
        Height="720" Width="1280"
        MinHeight="600" MinWidth="1024"
        Background="{StaticResource BackgroundDeepBrush}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <DataTemplate DataType="{x:Type viewmodels:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ChannelMonitorViewModel}">
            <views:ChannelMonitorView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:LogAnalyzerViewModel}">
            <views:LogAnalyzerView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Bar -->
        <Border Grid.Row="0" 
                Background="{StaticResource BackgroundPanelBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo/Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Ellipse Width="12" Height="12" Fill="{StaticResource AccentAmberBrush}"
                             VerticalAlignment="Center" Margin="0,0,10,0">
                        <Ellipse.Effect>
                            <BlurEffect Radius="3"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock Text="AUTOVISTA TEST BENCH"
                               FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentAmberBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- System Clock -->
                <TextBlock Grid.Column="2"
                           x:Name="SystemClockText"
                           FontFamily="Consolas" FontSize="14"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <TabControl Background="Transparent" 
                        BorderThickness="0"
                        Padding="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                        <Setter Property="Padding" Value="16,8"/>
                        <Setter Property="FontSize" Value="13"/>
                    </Style>
                </TabControl.Resources>

                <TabItem Header="DASHBOARD">
                    <ContentControl Content="{Binding DashboardViewModel}" />
                </TabItem>

                <TabItem Header="CHANNEL MONITOR">
                    <ContentControl Content="{Binding ChannelMonitorViewModel}" />
                </TabItem>

                <TabItem Header="LOG ANALYZER">
                    <ContentControl Content="{Binding LogAnalyzerViewModel}" />
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>